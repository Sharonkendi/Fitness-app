<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor"
            android:layout_marginBottom="24dp" />

        <!-- BIOMETRIC SECURITY SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biometric Security"
                    android:textStyle="bold"
                    android:textColor="@color/primaryColor"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use your fingerprint or face to unlock the app"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Fingerprint Unlock"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFaceUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Face Unlock"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvBiometricStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking hardware status..."
                    android:textSize="11sp"
                    android:textColor="@color/textColorSecondary"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- THEME SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appearance"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Light Mode" />
                    <RadioButton android:id="@+id/rbDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dark Mode" />
                    <RadioButton android:id="@+id/rbSystem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="System Default" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- UNITS SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Measurement Units"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <RadioGroup
                    android:id="@+id/rgUnits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbMetric" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Metric (kg, cm, km)" />
                    <RadioButton android:id="@+id/rbImperial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Imperial (lb, ft, mi)" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TRACKING PREFERENCES -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity Tracking"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBackgroundTracking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Background Activity Tracking"
                    android:layout_marginTop="8dp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGpsPrecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High Precision GPS" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save &amp; Apply Changes"
            android:backgroundTint="@color/primaryColor"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
